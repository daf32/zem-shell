{
  "schema_version": 1,
  "command": "go",
  "description": "The Go toolchain",
  "fallback": "files",
  "subcommands": [
    {"name": "build", "description": "Compile packages and dependencies",
     "options": [{"names": ["-o"], "description": "Write the result here",
                  "value": {"type": "files"}},
                 {"names": ["-race"], "description": "Enable the race detector"},
                 {"names": ["-v"], "description": "Print package names"},
                 {"names": ["-tags"], "description": "Build tags", "value": {"type": "none"}}],
     "args": [{"name": "package", "variadic": true, "source": {"type": "dirs"}}]},
    {"name": "run", "description": "Compile and run",
     "options": [{"names": ["-race"], "description": "Enable the race detector"}],
     "args": [{"name": "package", "variadic": true, "source": {"type": "files",
                                                               "extensions": [".go"]}}]},
    {"name": "test", "description": "Test packages",
     "options": [{"names": ["-run"], "description": "Run tests matching a pattern",
                  "value": {"type": "none"}},
                 {"names": ["-v"], "description": "Verbose output"},
                 {"names": ["-race"], "description": "Enable the race detector"},
                 {"names": ["-cover"], "description": "Report coverage"},
                 {"names": ["-bench"], "description": "Run benchmarks",
                  "value": {"type": "none"}},
                 {"names": ["-count"], "description": "Run each test n times",
                  "value": {"type": "none"}},
                 {"names": ["-timeout"], "description": "Panic after this long",
                  "value": {"type": "none"}}],
     "args": [{"name": "package", "variadic": true, "source": {"type": "dirs"}}]},
    {"name": "mod", "description": "Module maintenance",
     "subcommands": [
       {"name": "init", "description": "Start a new module"},
       {"name": "tidy", "description": "Add missing and drop unused modules"},
       {"name": "download", "description": "Download modules to the cache"},
       {"name": "vendor", "description": "Copy dependencies into vendor/"},
       {"name": "verify", "description": "Verify downloaded modules"},
       {"name": "why", "description": "Explain why a package is needed"},
       {"name": "graph", "description": "Print the module requirement graph"},
       {"name": "edit", "description": "Edit go.mod"}
     ]},
    {"name": "get", "description": "Add a dependency",
     "options": [{"names": ["-u"], "description": "Update to the newest version"}],
     "args": [{"name": "package", "variadic": true, "source": {"type": "none"}}]},
    {"name": "install", "description": "Compile and install packages",
     "args": [{"name": "package", "variadic": true, "source": {"type": "none"}}]},
    {"name": "fmt", "description": "Format source files",
     "args": [{"name": "package", "variadic": true, "source": {"type": "dirs"}}]},
    {"name": "vet", "description": "Report likely mistakes",
     "args": [{"name": "package", "variadic": true, "source": {"type": "dirs"}}]},
    {"name": "generate", "description": "Run code generators"},
    {"name": "work", "description": "Workspace maintenance",
     "subcommands": [{"name": "init"}, {"name": "use"}, {"name": "sync"}, {"name": "edit"}]},
    {"name": "tool", "description": "Run a Go tool",
     "subcommands": [{"name": "pprof"}, {"name": "trace"}, {"name": "cover"}]},
    {"name": "clean", "description": "Remove object files",
     "options": [{"names": ["-cache"], "description": "Clear the build cache"},
                 {"names": ["-modcache"], "description": "Clear the module cache"},
                 {"names": ["-testcache"], "description": "Clear cached test results"}]},
    {"name": "env", "description": "Print the Go environment"},
    {"name": "version", "description": "Print the Go version"},
    {"name": "doc", "description": "Show documentation for a package or symbol"},
    {"name": "list", "description": "List packages"}
  ]
}
