{
  "schema_version": 1,
  "command": "brew",
  "description": "The macOS/Linux package manager",
  "fallback": "files",
  "subcommands": [
    {"name": "install", "description": "Install a formula or cask",
     "options": [{"names": ["--cask"], "description": "Install a cask"},
                 {"names": ["--formula"], "description": "Install a formula"},
                 {"names": ["-f", "--force"], "description": "Install regardless"}],
     "args": [{"name": "formula", "variadic": true, "source": {"type": "none"}}]},
    {"name": "uninstall", "aliases": ["rm", "remove"], "description": "Remove a formula",
     "options": [{"names": ["--zap"], "description": "Remove all files (casks)"}],
     "args": [{"name": "formula", "variadic": true,
               "source": {"type": "provider", "name": "brew.installed"}}]},
    {"name": "upgrade", "description": "Upgrade outdated formulae",
     "args": [{"name": "formula", "variadic": true,
               "source": {"type": "provider", "name": "brew.installed"}}]},
    {"name": "list", "aliases": ["ls"], "description": "List installed formulae",
     "options": [{"names": ["--cask"], "description": "Only casks"},
                 {"names": ["--versions"], "description": "Show versions"}]},
    {"name": "info", "description": "Show information about a formula",
     "args": [{"name": "formula", "source": {"type": "provider", "name": "brew.installed"}}]},
    {"name": "search", "description": "Search for formulae",
     "args": [{"name": "text", "source": {"type": "none"}}]},
    {"name": "update", "description": "Fetch the newest formulae"},
    {"name": "outdated", "description": "List formulae with newer versions"},
    {"name": "cleanup", "description": "Remove stale downloads and versions",
     "options": [{"names": ["-n", "--dry-run"], "description": "Show what would go"},
                 {"names": ["-s"], "description": "Scrub the cache"}]},
    {"name": "doctor", "description": "Check the system for problems"},
    {"name": "services", "description": "Manage background services",
     "subcommands": [{"name": "list"}, {"name": "start"}, {"name": "stop"},
                     {"name": "restart"}, {"name": "run"}]},
    {"name": "tap", "description": "Add a third-party repository"},
    {"name": "untap", "description": "Remove a third-party repository"},
    {"name": "deps", "description": "Show a formula's dependencies",
     "args": [{"name": "formula", "source": {"type": "provider", "name": "brew.installed"}}]},
    {"name": "pin", "description": "Hold a formula at its current version",
     "args": [{"name": "formula", "source": {"type": "provider", "name": "brew.installed"}}]},
    {"name": "unpin", "description": "Allow a formula to be upgraded",
     "args": [{"name": "formula", "source": {"type": "provider", "name": "brew.installed"}}]},
    {"name": "link", "description": "Symlink a formula into the prefix"},
    {"name": "unlink", "description": "Remove a formula's symlinks"},
    {"name": "config", "description": "Show the Homebrew configuration"}
  ]
}
