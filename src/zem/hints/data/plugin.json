{
  "schema_version": 1,
  "command": "plugin",
  "description": "Inspect and manage plugins",
  "fallback": "none",
  "subcommands": [
    {"name": "list", "description": "List the plugins that were found"},
    {"name": "install", "description": "Install a plugin package",
     "options": [{"names": ["-y", "--yes"], "description": "Do not ask for confirmation"}],
     "args": [{"name": "package", "variadic": true, "source": {"type": "none"}}]},
    {"name": "remove", "description": "Uninstall a plugin package",
     "options": [{"names": ["-y", "--yes"], "description": "Do not ask for confirmation"}],
     "args": [{"name": "package", "variadic": true,
               "source": {"type": "provider", "name": "zem.plugin_packages"}}]},
    {"name": "packages", "description": "Installed packages that provide plugins"},
    {"name": "info", "description": "Show what one plugin provides",
     "args": [{"name": "name", "source": {"type": "provider", "name": "zem.plugins"}}]},
    {"name": "enable", "description": "Load a plugin again",
     "args": [{"name": "name", "source": {"type": "provider", "name": "zem.plugins"}}]},
    {"name": "disable", "description": "Stop loading a plugin",
     "args": [{"name": "name", "source": {"type": "provider", "name": "zem.plugins"}}]}
  ]
}
