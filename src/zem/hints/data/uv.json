{
  "schema_version": 1,
  "command": "uv",
  "description": "Python package and project manager",
  "fallback": "files",
  "options": [
    {"names": ["-q", "--quiet"], "description": "Less output", "inherited": true},
    {"names": ["-v", "--verbose"], "description": "More output", "inherited": true},
    {"names": ["--directory"], "description": "Run from this directory", "inherited": true,
     "value": {"type": "dirs"}},
    {"names": ["-V", "--version"], "description": "Print the uv version"}
  ],
  "subcommands": [
    {"name": "run", "description": "Run a command in the project environment",
     "options": [{"names": ["--with"], "description": "Add a package for this run",
                  "repeatable": true, "value": {"type": "none"}},
                 {"names": ["--no-sync"], "description": "Skip syncing first"}],
     "args": [{"name": "command", "source": {"type": "commands"}},
              {"name": "args", "variadic": true, "source": {"type": "none"}}]},
    {"name": "sync", "description": "Install the project's dependencies",
     "options": [{"names": ["--group"], "description": "Include a dependency group",
                  "value": {"type": "none"}},
                 {"names": ["--frozen"], "description": "Do not update the lockfile"},
                 {"names": ["--no-dev"], "description": "Skip development dependencies"}]},
    {"name": "add", "description": "Add a dependency",
     "options": [{"names": ["--dev"], "description": "Add to the dev group"},
                 {"names": ["--group"], "description": "Add to this group",
                  "value": {"type": "none"}},
                 {"names": ["--optional"], "description": "Add to an extra",
                  "value": {"type": "none"}},
                 {"names": ["-e", "--editable"], "description": "Add as editable",
                  "value": {"type": "dirs"}}],
     "args": [{"name": "package", "variadic": true, "source": {"type": "none"}}]},
    {"name": "remove", "description": "Remove a dependency",
     "options": [{"names": ["--dev"], "description": "Remove from the dev group"}],
     "args": [{"name": "package", "variadic": true, "source": {"type": "none"}}]},
    {"name": "lock", "description": "Update the lockfile",
     "options": [{"names": ["--check"], "description": "Fail if it would change"}]},
    {"name": "init", "description": "Create a new project",
     "options": [{"names": ["--lib"], "description": "Create a library"},
                 {"names": ["--app"], "description": "Create an application"},
                 {"names": ["--package"], "description": "Create a packaged project"}],
     "args": [{"name": "path", "source": {"type": "dirs"}}]},
    {"name": "venv", "description": "Create a virtual environment",
     "options": [{"names": ["-p", "--python"], "description": "Interpreter to use",
                  "value": {"type": "none"}},
                 {"names": ["--seed"], "description": "Install pip into it"}],
     "args": [{"name": "path", "source": {"type": "dirs"}}]},
    {"name": "pip", "description": "The pip-compatible interface",
     "subcommands": [
       {"name": "install", "description": "Install packages",
        "options": [{"names": ["-r", "--requirement"], "description": "From a requirements file",
                     "value": {"type": "files", "extensions": [".txt"]}},
                    {"names": ["-e", "--editable"], "description": "From a source tree",
                     "value": {"type": "dirs"}},
                    {"names": ["-U", "--upgrade"], "description": "Upgrade the package"}],
        "args": [{"name": "package", "variadic": true, "source": {"type": "none"}}]},
       {"name": "uninstall", "description": "Remove packages",
        "args": [{"name": "package", "variadic": true, "source": {"type": "none"}}]},
       {"name": "list", "description": "List installed packages"},
       {"name": "freeze", "description": "Output requirements"},
       {"name": "show", "description": "Show package details"},
       {"name": "compile", "description": "Compile requirements",
        "args": [{"name": "file", "source": {"type": "files"}}]},
       {"name": "sync", "description": "Sync an environment with requirements",
        "args": [{"name": "file", "source": {"type": "files", "extensions": [".txt"]}}]},
       {"name": "tree", "description": "Show the dependency tree"}
     ]},
    {"name": "tool", "description": "Run and install command-line tools",
     "subcommands": [
       {"name": "install", "description": "Install a tool",
        "options": [{"names": ["--with"], "description": "Include an extra package",
                     "repeatable": true, "value": {"type": "none"}},
                    {"names": ["-f", "--force"], "description": "Reinstall"}],
        "args": [{"name": "package", "source": {"type": "none"}}]},
       {"name": "uninstall", "description": "Remove a tool",
        "args": [{"name": "tool", "source": {"type": "provider", "name": "uv.tools"}}]},
       {"name": "upgrade", "description": "Upgrade a tool",
        "options": [{"names": ["--all"], "description": "Upgrade every tool"}],
        "args": [{"name": "tool", "source": {"type": "provider", "name": "uv.tools"}}]},
       {"name": "list", "description": "List installed tools"},
       {"name": "run", "description": "Run a tool without installing it"},
       {"name": "dir", "description": "Show the tool directory"}
     ]},
    {"name": "python", "description": "Manage Python versions",
     "subcommands": [
       {"name": "install", "description": "Download a Python version"},
       {"name": "list", "description": "List available versions"},
       {"name": "find", "description": "Locate an interpreter"},
       {"name": "pin", "description": "Pin the project's Python version"},
       {"name": "uninstall", "description": "Remove a Python version"}
     ]},
    {"name": "build", "description": "Build the project's distributions"},
    {"name": "publish", "description": "Upload distributions to an index"},
    {"name": "tree", "description": "Show the project's dependency tree"},
    {"name": "export", "description": "Export the lockfile in another format",
     "options": [{"names": ["--format"], "description": "Target format",
                  "value": {"type": "values",
                            "items": ["requirements-txt", "pylock.toml"]}}]},
    {"name": "cache", "description": "Manage the uv cache",
     "subcommands": [{"name": "clean"}, {"name": "prune"}, {"name": "dir"}]},
    {"name": "self", "description": "Manage uv itself",
     "subcommands": [{"name": "update"}, {"name": "version"}]}
  ]
}
