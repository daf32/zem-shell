{
  "schema_version": 1,
  "command": "kubectl",
  "description": "Control a Kubernetes cluster",
  "fallback": "files",
  "options": [
    {"names": ["-n", "--namespace"], "description": "Namespace to use", "inherited": true,
     "value": {"type": "command",
               "run": ["kubectl", "get", "namespaces", "-o", "name"],
               "cache_scope": "global", "cache_ttl_ms": 30000, "timeout_ms": 1500}},
    {"names": ["--context"], "description": "Kubeconfig context", "inherited": true,
     "value": {"type": "command",
               "run": ["kubectl", "config", "get-contexts", "-o", "name"],
               "cache_scope": "global", "cache_ttl_ms": 60000, "timeout_ms": 1500}},
    {"names": ["-o", "--output"], "description": "Output format", "inherited": true,
     "value": {"type": "values",
               "items": ["json", "yaml", "wide", "name", "jsonpath", "go-template"]}},
    {"names": ["-A", "--all-namespaces"], "description": "Across every namespace",
     "inherited": true}
  ],
  "subcommands": [
    {"name": "get", "description": "Display resources",
     "options": [{"names": ["-w", "--watch"], "description": "Watch for changes"},
                 {"names": ["-l", "--selector"], "description": "Label selector",
                  "value": {"type": "none"}}],
     "args": [{"name": "resource", "source": {"type": "provider", "name": "k8s.resources"}},
              {"name": "name", "variadic": true, "source": {"type": "none"}}]},
    {"name": "describe", "description": "Show the details of a resource",
     "args": [{"name": "resource", "source": {"type": "provider", "name": "k8s.resources"}},
              {"name": "name", "source": {"type": "none"}}]},
    {"name": "logs", "description": "Print a container's logs",
     "options": [{"names": ["-f", "--follow"], "description": "Keep streaming"},
                 {"names": ["-p", "--previous"], "description": "Logs of the previous instance"},
                 {"names": ["-c", "--container"], "description": "Container name",
                  "value": {"type": "none"}},
                 {"names": ["--tail"], "description": "Lines from the end",
                  "value": {"type": "none"}}],
     "args": [{"name": "pod", "source": {"type": "provider", "name": "k8s.pods"}}]},
    {"name": "exec", "description": "Run a command in a container",
     "options": [{"names": ["-i", "--stdin"], "description": "Keep STDIN open"},
                 {"names": ["-t", "--tty"], "description": "Allocate a TTY"},
                 {"names": ["-c", "--container"], "description": "Container name",
                  "value": {"type": "none"}}],
     "args": [{"name": "pod", "source": {"type": "provider", "name": "k8s.pods"}},
              {"name": "command", "variadic": true, "source": {"type": "none"}}]},
    {"name": "apply", "description": "Apply a configuration",
     "options": [{"names": ["-f", "--filename"], "description": "Manifest to apply",
                  "value": {"type": "files", "extensions": [".yaml", ".yml", ".json"]}},
                 {"names": ["-k", "--kustomize"], "description": "Kustomization directory",
                  "value": {"type": "dirs"}},
                 {"names": ["--dry-run"], "description": "Do not persist",
                  "value": {"type": "values", "items": ["none", "client", "server"]}}]},
    {"name": "delete", "description": "Delete resources",
     "options": [{"names": ["-f", "--filename"], "description": "Manifest to delete",
                  "value": {"type": "files", "extensions": [".yaml", ".yml", ".json"]}},
                 {"names": ["--force"], "description": "Delete immediately"}],
     "args": [{"name": "resource", "source": {"type": "provider", "name": "k8s.resources"}},
              {"name": "name", "variadic": true, "source": {"type": "none"}}]},
    {"name": "port-forward", "description": "Forward a local port to a pod",
     "args": [{"name": "pod", "source": {"type": "provider", "name": "k8s.pods"}},
              {"name": "ports", "variadic": true, "source": {"type": "none"}}]},
    {"name": "rollout", "description": "Manage a resource rollout",
     "subcommands": [{"name": "status"}, {"name": "restart"}, {"name": "undo"},
                     {"name": "history"}, {"name": "pause"}, {"name": "resume"}]},
    {"name": "scale", "description": "Change the number of replicas",
     "options": [{"names": ["--replicas"], "description": "Desired replicas",
                  "value": {"type": "none"}}]},
    {"name": "config", "description": "Manage the kubeconfig",
     "subcommands": [{"name": "get-contexts"}, {"name": "use-context"},
                     {"name": "current-context"}, {"name": "set-context"}, {"name": "view"}]},
    {"name": "top", "description": "Show resource usage",
     "subcommands": [{"name": "pod"}, {"name": "node"}]},
    {"name": "cluster-info", "description": "Show cluster endpoints"},
    {"name": "edit", "description": "Edit a resource",
     "args": [{"name": "resource", "source": {"type": "provider", "name": "k8s.resources"}}]},
    {"name": "create", "description": "Create a resource",
     "options": [{"names": ["-f", "--filename"], "description": "Manifest",
                  "value": {"type": "files", "extensions": [".yaml", ".yml", ".json"]}}]}
  ]
}
