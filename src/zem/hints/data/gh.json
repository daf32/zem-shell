{
  "schema_version": 1,
  "command": "gh",
  "description": "GitHub on the command line",
  "fallback": "files",
  "options": [
    {"names": ["-R", "--repo"], "description": "Act on this repository", "inherited": true,
     "value": {"type": "none"}},
    {"names": ["--version"], "description": "Print the gh version"}
  ],
  "subcommands": [
    {"name": "pr", "description": "Manage pull requests",
     "subcommands": [
       {"name": "create", "description": "Open a pull request",
        "options": [{"names": ["-t", "--title"], "description": "Title",
                     "value": {"type": "none"}},
                    {"names": ["-b", "--body"], "description": "Body", "value": {"type": "none"}},
                    {"names": ["-B", "--base"], "description": "Base branch",
                     "value": {"type": "provider", "name": "git.branches"}},
                    {"names": ["-d", "--draft"], "description": "Open as a draft"},
                    {"names": ["-w", "--web"], "description": "Continue in the browser"},
                    {"names": ["-f", "--fill"], "description": "Use commit messages"}]},
       {"name": "list", "description": "List pull requests",
        "options": [{"names": ["-s", "--state"], "description": "Filter by state",
                     "value": {"type": "values", "items": ["open", "closed", "merged", "all"]}},
                    {"names": ["-a", "--author"], "description": "Filter by author",
                     "value": {"type": "none"}},
                    {"names": ["-L", "--limit"], "description": "How many to show",
                     "value": {"type": "none"}}]},
       {"name": "view", "description": "Show a pull request",
        "options": [{"names": ["-w", "--web"], "description": "Open in the browser"},
                    {"names": ["-c", "--comments"], "description": "Show comments"}]},
       {"name": "checkout", "description": "Check a pull request out locally"},
       {"name": "merge", "description": "Merge a pull request",
        "options": [{"names": ["-s", "--squash"], "description": "Squash merge"},
                    {"names": ["-m", "--merge"], "description": "Merge commit"},
                    {"names": ["-r", "--rebase"], "description": "Rebase merge"},
                    {"names": ["-d", "--delete-branch"], "description": "Delete the branch"},
                    {"names": ["--auto"], "description": "Merge once checks pass"}]},
       {"name": "diff", "description": "Show a pull request's changes"},
       {"name": "close", "description": "Close a pull request"},
       {"name": "reopen", "description": "Reopen a pull request"},
       {"name": "review", "description": "Review a pull request"},
       {"name": "status", "description": "Show your pull requests"},
       {"name": "checks", "description": "Show check status"}
     ]},
    {"name": "issue", "description": "Manage issues",
     "subcommands": [
       {"name": "create", "description": "Open an issue",
        "options": [{"names": ["-t", "--title"], "description": "Title",
                     "value": {"type": "none"}},
                    {"names": ["-b", "--body"], "description": "Body",
                     "value": {"type": "none"}},
                    {"names": ["-l", "--label"], "description": "Add a label",
                     "repeatable": true, "value": {"type": "none"}}]},
       {"name": "list", "description": "List issues",
        "options": [{"names": ["-s", "--state"], "description": "Filter by state",
                     "value": {"type": "values", "items": ["open", "closed", "all"]}}]},
       {"name": "view", "description": "Show an issue"},
       {"name": "close", "description": "Close an issue"},
       {"name": "reopen", "description": "Reopen an issue"},
       {"name": "comment", "description": "Comment on an issue"}
     ]},
    {"name": "repo", "description": "Manage repositories",
     "subcommands": [
       {"name": "clone", "description": "Clone a repository",
        "args": [{"name": "repository", "source": {"type": "none"}},
                 {"name": "directory", "source": {"type": "dirs"}}]},
       {"name": "create", "description": "Create a repository",
        "options": [{"names": ["--public"], "description": "Make it public"},
                    {"names": ["--private"], "description": "Make it private"},
                    {"names": ["--source"], "description": "Local source directory",
                     "value": {"type": "dirs"}}]},
       {"name": "view", "description": "Show a repository",
        "options": [{"names": ["-w", "--web"], "description": "Open in the browser"}]},
       {"name": "fork", "description": "Fork a repository"},
       {"name": "sync", "description": "Sync a fork with upstream"},
       {"name": "list", "description": "List repositories"}
     ]},
    {"name": "run", "description": "Manage workflow runs",
     "subcommands": [
       {"name": "list", "description": "List recent runs"},
       {"name": "view", "description": "Show a run",
        "options": [{"names": ["--log"], "description": "Show the log"},
                    {"names": ["--log-failed"], "description": "Show failed steps' logs"}]},
       {"name": "watch", "description": "Watch a run until it finishes"},
       {"name": "rerun", "description": "Rerun a run",
        "options": [{"names": ["--failed"], "description": "Only failed jobs"}]},
       {"name": "cancel", "description": "Cancel a run"},
       {"name": "download", "description": "Download artifacts"}
     ]},
    {"name": "workflow", "description": "Manage workflows",
     "subcommands": [{"name": "list"}, {"name": "view"}, {"name": "run"},
                     {"name": "enable"}, {"name": "disable"}]},
    {"name": "release", "description": "Manage releases",
     "subcommands": [{"name": "list"}, {"name": "view"}, {"name": "create"},
                     {"name": "delete"}, {"name": "upload"}, {"name": "download"}]},
    {"name": "auth", "description": "Authenticate with GitHub",
     "subcommands": [{"name": "login"}, {"name": "logout"}, {"name": "status"},
                     {"name": "refresh"}, {"name": "token"}]},
    {"name": "api", "description": "Make an authenticated API request",
     "options": [{"names": ["-X", "--method"], "description": "HTTP method",
                  "value": {"type": "values",
                            "items": ["GET", "POST", "PATCH", "PUT", "DELETE"]}},
                 {"names": ["-f", "--raw-field"], "description": "Add a string parameter",
                  "repeatable": true, "value": {"type": "none"}},
                 {"names": ["--jq"], "description": "Filter the response with jq",
                  "value": {"type": "none"}}]},
    {"name": "browse", "description": "Open the repository in a browser"},
    {"name": "gist", "description": "Manage gists",
     "subcommands": [{"name": "create"}, {"name": "list"}, {"name": "view"},
                     {"name": "edit"}, {"name": "delete"}]},
    {"name": "search", "description": "Search GitHub",
     "subcommands": [{"name": "repos"}, {"name": "issues"}, {"name": "prs"},
                     {"name": "code"}, {"name": "commits"}]}
  ]
}
